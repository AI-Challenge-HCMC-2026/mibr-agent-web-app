# ckey.vn API credentials — server-side only (consumed by the Vite proxy).
# Copy this file to `.env` and paste your API key. NEVER prefix with VITE_,
# or the value gets bundled into client JS and leaks publicly.
#
# Get your API Key from ckey.vn profile or API keys list.
CKEY_APIKEY='paste-your-ckey-api-key-here'


# Password for the admin dashboard login. The client sends this as an
# `x-admin-key` header; the proxy (both the Vite dev proxy and the Vercel edge
# function) only returns data when it matches. Pick a strong secret.
# On Vercel, set this in Project Settings > Environment Variables (not committed).
ADMIN_PASSWORD='choose-a-strong-password'

# Supabase — used client-side to check the admin-email allowlist (admin_users).
# These two ARE meant to be public (the anon/publishable key is safe to ship in
# the browser bundle), so the VITE_ prefix is correct here. Do NOT put the
# service_role key in this file.
VITE_SUPABASE_URL='https://your-project-ref.supabase.co'
VITE_SUPABASE_ANON_KEY='your-anon-or-publishable-key'
