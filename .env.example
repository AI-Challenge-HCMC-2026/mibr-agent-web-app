# ckey.vn API Key — prefix with VITE_ so it is accessible in frontend.
VITE_CKEY_APIKEY='paste-your-ckey-api-key-here'

# Password for the admin dashboard login.
ADMIN_PASSWORD='choose-a-strong-password'

# Supabase — used client-side to check the admin-email allowlist (admin_users).
VITE_SUPABASE_URL='https://your-project-ref.supabase.co'
VITE_SUPABASE_ANON_KEY='your-anon-or-publishable-key'
