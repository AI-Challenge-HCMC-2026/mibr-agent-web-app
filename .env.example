# Supabase project (https://supabase.com/dashboard) — URL and anon key
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# MCP Server URL (FastMCP endpoint, must end with /mcp/)
VITE_MCP_SERVER_URL="https://your-mcp-server.com/mcp/"

# Gemini AI API Key from Google AI Studio (https://aistudio.google.com)
VITE_GEMINI_API_KEY="your-gemini-api-key-here"
